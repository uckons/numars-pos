{
  "name": "numars-pos-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "print-agent": "node scripts/local-print-agent.js",
    "print-agent:win": "node scripts/local-print-agent.js",
    "migrate:007": "node scripts/apply-migration-007.js",
    "journal:dedupe:pos-payment": "node scripts/dedupe-pos-payment-journals.js",
    "journal:repair:zero-total": "node scripts/repair-zero-total-pos-orders.js",
    "recon:parse-output": "node scripts/recon-output-parser.js",
    "recon:cron-alert": "bash scripts/cron-recon-alert.sh",
    "journal:repair:missing-pos-payment": "node scripts/repair-missing-pos-payment-journals.js",
    "migrate:010": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../database/migrations/010_sprint4_ap_ar_payroll_staff.sql",
    "recon:sprint4": "node scripts/sprint4-recon-job.js",
    "test:sprint4-recon": "node --test tests/sprint4-recon-job.test.js",
    "test:payroll-flex": "node --test tests/payroll-flex.service.test.js"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "escpos-usb": "^3.0.0-alpha.4",
    "express": "^5.2.1",
    "glob": "^13.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "tough-cookie": "^6.0.0"
  },
  "overrides": {
    "form-data": "^4.0.1",
    "qs": "^6.14.1",
    "uuid": "^8.3.2",
    "request": {
      "tough-cookie": "^4.1.4"
    }
  },
  "allowScripts": {
    "bcrypt": true,
    "usb": true
  }
}
