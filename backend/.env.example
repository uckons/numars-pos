# =========================
# Database
# =========================
# Use one of the options below:
# 1) Single URL
DATABASE_URL=postgres://username:password@localhost:5432/numarsbiz

# 2) Split variables (used as fallback by scripts)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=numarsbiz
DB_PASS=change_me
DB_NAME=numarsbiz

# =========================
# Feature Flags (default OFF)
# =========================
FEATURE_ACCOUNTING_V2=false
FEATURE_APPROVAL_MATRIX_V1=false
FEATURE_FORMULA_ENGINE_V1=false
FEATURE_PAYROLL_STAFF_V1=false
FEATURE_PAYROLL_THERAPIST_V1=false
FEATURE_PAYROLL_AGENT_V1=false
FEATURE_BANK_RECON_V1=false
FEATURE_MULTI_OUTLET_TRANSFER_V1=false


# =========================
# Ops Alerting / Reconciliation
# =========================
# Optional: Discord/Slack/other webhook URL for recon alert
ALERT_WEBHOOK_URL=
# Optional defaults for cron-recon-alert.sh
RECON_BRANCH_ID=1
RECON_RETENTION_DAYS=14
